# Copy to .env and fill in. Never commit .env.

# MongoDB. Local uses the docker-compose replica set; prod uses an Atlas SRV string.
DATABASE_URL="mongodb://localhost:27017/signcraft?directConnection=true"
# inside docker compose the app uses mongodb://mongo:27017/signcraft?directConnection=true

# Cloudflare R2 (S3-compatible). Keys come from R2 > Manage API tokens > Create Account API token.
# The secret is shown exactly once at creation; if lost, Roll the token to get a new pair.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="signcraft-bucket"

# Public origin, used for R2 CORS and absolute links.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional. Override the host port `docker compose up` publishes the app on. Default 3000.
# APP_PORT="3001"
# Optional. Host port for the compose Mongo when a local mongod already owns 27017. Default 27017.
# MONGO_PORT="27018"

# Optional. Installer claim window in milliseconds. Default 180000 (3 minutes).
# CLAIM_TTL_MS="180000"
