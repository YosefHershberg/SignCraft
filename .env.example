# Copy to .env and fill in. Never commit .env.

# MongoDB Atlas SRV string (M0 free tier is enough). Atlas clusters are replica sets, which
# Prisma on Mongo and change streams both require. Same value for local dev and Vercel.
DATABASE_URL="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/signcraft?retryWrites=true&w=majority"

# Cloudflare R2 (S3-compatible). Keys come from R2 > Manage API tokens > Create Account API token.
# The secret is shown exactly once at creation; if lost, Roll the token to get a new pair.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="signcraft-bucket"

# Public origin, used for R2 CORS and absolute links.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional. Installer claim window in milliseconds. Default 180000 (3 minutes).
# CLAIM_TTL_MS="180000"
